# Step 2: Backend Dockerfile for Node/Express API
FROM node:18-alpine

WORKDIR /app

# Copy package definitions
COPY package*.json ./

# Install dependencies inside the container
RUN npm install

# Copy application source code
COPY . .

# Expose backend port
EXPOSE 5000

# Set environment variables (referencing MongoDB container by service name)
ENV PORT=5000
ENV MONGO_URI=mongodb://mongodb:27017/task-manager
ENV JWT_SECRET=supersecretkey_student_lab_2026

# Start the Express server
CMD ["node", "server.js"]
