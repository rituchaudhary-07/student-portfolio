# Step 3 & Supplementary Problem 2: Multi-stage Dockerfile for React Vite Frontend
# Stage 1: Build Stage
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Stage 2: Production Server Stage
FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY --from=build /app/dist ./dist
COPY --from=build /app/vite.config.js ./vite.config.js

EXPOSE 5173

# Serve production preview accessible from outside container
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
